{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,

        "library/": true,
        "local/": true,
        "temp/": true,
        "build/": true,
        "**/*.meta": true
    },

    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "build/": true,
        "temp/": true,
        "library/": true
    },

    "editor.tabSize": 4,
    "editor.formatOnSave": true,
    "prettier.tabWidth": 4,
    "prettier.printWidth": 160,

    "editor.defaultFormatter": "esbenp.prettier-vscode"
}
